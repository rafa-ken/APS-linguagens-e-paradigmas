%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>

extern int yylineno;
extern FILE *yyin;
int yylex(void);
void yyerror(const char *s);

FILE *out;
int label_count = 0;
int new_label() { return label_count++; }

typedef struct Sym {
  char *name;
  int slot;
  struct Sym *next;
} Sym;
Sym *symtab = NULL;
int next_slot = 0;

int get_slot(const char *name) {
  for (Sym *p = symtab; p; p = p->next) if (strcmp(p->name, name) == 0) return p->slot;
  return -1;
}
int add_symbol(const char *name) {
  if (get_slot(name) != -1) return -1;
  Sym *s = malloc(sizeof(Sym));
  s->name = strdup(name);
  s->slot = next_slot++;
  s->next = symtab;
  symtab = s;
  return s->slot;
}

void emit(const char *fmt, ...) {
  va_list ap;
  va_start(ap, fmt);
  vfprintf(out, fmt, ap);
  va_end(ap);
}

%}

%union {
  int num;
  char *str;
}

%token <str> NAME
%token <num> NUMBER
%token JOGADOR PASSE TORCIDA ATAQUE DEFESA ENQUANTO
%token EQ NEQ LE GE AND OR

%type <num> expr logic_or logic_and equality relational additive term factor

%left OR
%left AND
%nonassoc EQ NEQ
%nonassoc '<' '>' LE GE
%left '+' '-'
%left '*' '/'
%right UMINUS
%nonassoc LOWER_THAN_DEFESA

%%

program:
    /* empty */
  | program stmt
  ;

stmt:
    decl_stmt ';'
  | assign_stmt ';'
  | print_stmt ';'
  | if_stmt
  | while_stmt
  ;

decl_stmt:
    JOGADOR NAME {
      if (add_symbol($2) == -1) {
        fprintf(stderr, "Erro: jogador '%s' já declarado (linha %d)\n", $2, yylineno);
        exit(1);
      }
      free($2);
    }
  ;

assign_stmt:
    NAME PASSE expr {
      int slot = get_slot($1);
      if (slot == -1) {
        fprintf(stderr, "Erro: variável '%s' não declarada (linha %d)\n", $1, yylineno);
        exit(1);
      }
      emit("STORE %d\n", slot);
      free($1);
    }
  ;

print_stmt:
    TORCIDA '(' expr ')' {
      emit("PRINT\n");
    }
  ;

if_stmt:
    ATAQUE '(' expr ')' block %prec LOWER_THAN_DEFESA {
      int Lend = new_label();
      emit("JZ L%d\n", Lend);
      /* block already emitted by recursive rules */
      emit("LABEL L%d\n", Lend);
    }
  | ATAQUE '(' expr ')' block DEFESA block {
      int Lelse = new_label();
      int Lend = new_label();
      emit("JZ L%d\n", Lelse);
      emit("JMP L%d\n", Lend);
      emit("LABEL L%d\n", Lelse);
      emit("LABEL L%d\n", Lend);
    }
  ;

while_stmt:
    ENQUANTO '(' expr ')' block {
      int Lstart = new_label();
      int Lend = new_label();
      emit("LABEL L%d\n", Lstart);
      /* condition on stack */
      emit("JZ L%d\n", Lend);
      /* body emitted */
      emit("JMP L%d\n", Lstart);
      emit("LABEL L%d\n", Lend);
    }
  ;

block:
    '{' '}' { }
  | '{' program '}' { }
  ;

expr:
    logic_or { }
  ;

logic_or:
    logic_and { }
  | logic_or OR logic_and {
      emit("OR\n");
    }
  ;

logic_and:
    equality { }
  | logic_and AND equality {
      emit("AND\n");
    }
  ;

equality:
    relational { }
  | equality EQ relational { emit("EQ\n"); }
  | equality NEQ relational { emit("NEQ\n"); }
  ;

relational:
    additive { }
  | relational '<' additive { emit("LT\n"); }
  | relational '>' additive { emit("GT\n"); }
  | relational LE additive { emit("LE\n"); }
  | relational GE additive { emit("GE\n"); }
  ;

additive:
    term { }
  | additive '+' term { emit("ADD\n"); }
  | additive '-' term { emit("SUB\n"); }
  ;

term:
    factor { }
  | term '*' factor { emit("MUL\n"); }
  | term '/' factor { emit("DIV\n"); }
  ;

factor:
    '-' factor %prec UMINUS { emit("NEG\n"); }
  | NUMBER { emit("PUSH %d\n", $1); }
  | NAME {
      int slot = get_slot($1);
      if (slot == -1) {
        fprintf(stderr, "Erro: variável '%s' não declarada (linha %d)\n", $1, yylineno);
        exit(1);
      }
      emit("LOAD %d\n", slot);
      free($1);
    }
  | '(' expr ')' { }
  ;

%%

void yyerror(const char *s) {
  fprintf(stderr, "Erro sintático (linha %d): %s\n", yylineno, s);
  exit(1);
}

int main(int argc, char **argv) {
  if (argc < 2) {
    fprintf(stderr, "Uso: %s <input> [output.asm]\n", argv[0]);
    return 1;
  }
  FILE *in = fopen(argv[1], "r");
  if (!in) { perror("fopen"); return 1; }
  if (argc >= 3) out = fopen(argv[2], "w"); else out = fopen("out.asm", "w");
  if (!out) { perror("fopen out"); return 1; }
  yyin = in;
  fprintf(out, "# SimpleStackVM assembly generated by FutebolLang\n");
  yyparse();
  fprintf(out, "# end\n");
  fclose(out);
  fclose(in);
  return 0;
}